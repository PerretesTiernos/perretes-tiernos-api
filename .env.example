# =============================================================================
# Entorno de aplicación (development | staging | production | test)
# =============================================================================
APP_NAME="Perretes Tiernos API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# Base de Datos PostgreSQL en Supabase (Pooler puerto 6543 o directa 5432)
# =============================================================================
DATABASE_URL="postgresql+asyncpg://postgres.project_ref:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# =============================================================================
# Redis & Workers ARQ (Railway)
# =============================================================================
REDIS_URL="redis://localhost:6379/0"

# =============================================================================
# Supabase Auth & Storage (Nunca exponer service_role al cliente)
# =============================================================================
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-min-32-chars"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWKS_URL=""
SUPABASE_STORAGE_BUCKET_PUBLIC="public-media"
SUPABASE_STORAGE_BUCKET_PRIVATE="private-verifications"

# =============================================================================
# Observabilidad, Correo y Servicios Externos
# =============================================================================
SENTRY_DSN=""
RESEND_API_KEY=""
EMAIL_FROM="no-reply@perretestiernos.es"
MAPS_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# =============================================================================
# Seguridad y Rate Limiting
# =============================================================================
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_SENSITIVE_PER_MINUTE=15

